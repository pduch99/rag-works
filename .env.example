# copy this to .env and fill in at least one way to run a model. .env is gitignored, never commit it

# which one the app starts on: gemini, groq or ollama
RAG_PROVIDER=gemini

# gemini, free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_VISION_MODEL=gemini-3.8-flash

# groq, free key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_TEXT_MODEL=openai/gpt-oss-20b
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# ollama, runs on your own gpu, no key, no limits. see the readme for the 3 setup commands
OLLAMA_VISION_MODEL=rag-vl
OLLAMA_TEXT_MODEL=rag-vl
# OLLAMA_URL=http://localhost:11434/v1

# local embedding model: bge (default), minilm, or gemini (uses your gemini quota)
RAG_EMBEDDER=bge

# parallel model calls. keep 1 for ollama (one gpu), 2-3 for the cloud free tiers
EVAL_WORKERS=1
LLM_WORKERS=1

# set to 1 when hosting the app for other people, hides the paste-your-key box
# RAG_PUBLIC=1
